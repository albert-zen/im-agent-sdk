{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.imagent.dev/v1/messages.schema.json",
  "title": "IM Agent messages",
  "$defs": {
    "ConversationRef": {
      "type": "object",
      "required": ["channelInstanceId", "nativeConversationId"],
      "properties": {
        "channelInstanceId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "nativeConversationId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "TextContent": {
      "type": "object",
      "required": ["type", "text", "format"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "format": { "enum": ["plain", "markdown"] }
      },
      "additionalProperties": false
    },
    "LocalPath": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "local_path" },
        "path": { "$ref": "common.schema.json#/$defs/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "RemoteUrl": {
      "type": "object",
      "required": ["kind", "url"],
      "properties": {
        "kind": { "const": "remote_url" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "AttachmentHandle": {
      "type": "object",
      "required": ["kind", "handleId"],
      "properties": {
        "kind": { "const": "attachment_handle" },
        "handleId": { "$ref": "common.schema.json#/$defs/Identifier" }
      },
      "additionalProperties": false
    },
    "AttachmentSource": {
      "oneOf": [
        { "$ref": "#/$defs/LocalPath" },
        { "$ref": "#/$defs/RemoteUrl" },
        { "$ref": "#/$defs/AttachmentHandle" }
      ]
    },
    "AttachmentContent": {
      "type": "object",
      "required": ["type", "attachmentId", "mediaType", "source"],
      "properties": {
        "type": { "const": "attachment" },
        "attachmentId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "mediaType": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "source": { "$ref": "#/$defs/AttachmentSource" },
        "filename": { "type": ["string", "null"] },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    },
    "Content": {
      "oneOf": [
        { "$ref": "#/$defs/TextContent" },
        { "$ref": "#/$defs/AttachmentContent" }
      ]
    },
    "InboundMessage": {
      "type": "object",
      "required": [
        "messageId",
        "conversationRef",
        "sender",
        "content",
        "createdAt"
      ],
      "properties": {
        "messageId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "conversationRef": { "$ref": "#/$defs/ConversationRef" },
        "sender": { "$ref": "common.schema.json#/$defs/Identifier" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/Content" },
          "minItems": 1
        },
        "replyTo": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    },
    "OutboundMessage": {
      "type": "object",
      "required": [
        "deliveryId",
        "conversationRef",
        "content",
        "createdAt"
      ],
      "properties": {
        "deliveryId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "conversationRef": { "$ref": "#/$defs/ConversationRef" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/Content" },
          "minItems": 1
        },
        "replyTo": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    },
    "AgentInput": {
      "type": "object",
      "required": ["clientMessageId", "content"],
      "properties": {
        "clientMessageId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "sender": { "type": ["string", "null"] },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/Content" },
          "minItems": 1
        },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    },
    "InputContinuationPreference": {
      "enum": ["prefer_active_turn", "start_new_turn"]
    },
    "InputDisposition": {
      "enum": ["started", "steered"]
    },
    "TurnReplyCorrelationPolicy": {
      "enum": ["create_new", "preserve_existing"]
    },
    "ApplicationInputDispatch": {
      "type": "object",
      "required": [
        "threadRef",
        "clientMessageId",
        "disposition",
        "correlationPolicy"
      ],
      "properties": {
        "threadRef": {
          "$ref": "resources.schema.json#/$defs/ThreadRef"
        },
        "clientMessageId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "disposition": { "$ref": "#/$defs/InputDisposition" },
        "correlationPolicy": {
          "$ref": "#/$defs/TurnReplyCorrelationPolicy"
        },
        "expectedTurnRef": {
          "oneOf": [
            { "$ref": "resources.schema.json#/$defs/TurnRef" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "started" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "correlationPolicy": { "const": "create_new" },
              "expectedTurnRef": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "steered" } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["expectedTurnRef"],
            "properties": {
              "correlationPolicy": { "const": "preserve_existing" },
              "expectedTurnRef": {
                "$ref": "resources.schema.json#/$defs/TurnRef"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "AcceptedTurn": {
      "type": "object",
      "required": [
        "turnRef",
        "clientMessageId",
        "disposition",
        "correlationPolicy"
      ],
      "properties": {
        "turnRef": { "$ref": "resources.schema.json#/$defs/TurnRef" },
        "clientMessageId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "disposition": { "$ref": "#/$defs/InputDisposition" },
        "correlationPolicy": {
          "$ref": "#/$defs/TurnReplyCorrelationPolicy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "started" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "correlationPolicy": { "const": "create_new" }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "steered" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "correlationPolicy": { "const": "preserve_existing" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "AgentMessage": {
      "type": "object",
      "required": [
        "agentItemId",
        "threadRef",
        "role",
        "content",
        "createdAt"
      ],
      "properties": {
        "agentItemId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "threadRef": {
          "$ref": "resources.schema.json#/$defs/ThreadRef"
        },
        "role": {
          "enum": ["user", "assistant", "system", "tool"]
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/Content" },
          "minItems": 1
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "clientMessageId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    }
  }
}
