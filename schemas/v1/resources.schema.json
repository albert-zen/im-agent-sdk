{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.imagent.dev/v1/resources.schema.json",
  "title": "IM Agent resources",
  "$defs": {
    "ApplicationRef": {
      "type": "object",
      "required": ["applicationInstanceId"],
      "properties": {
        "applicationInstanceId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "RequestRef": {
      "type": "object",
      "required": ["applicationRef", "nativeRequestId"],
      "properties": {
        "applicationRef": { "$ref": "#/$defs/ApplicationRef" },
        "nativeRequestId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "ProjectRef": {
      "type": "object",
      "required": ["applicationInstanceId", "projectId"],
      "properties": {
        "applicationInstanceId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "projectId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        }
      },
      "additionalProperties": false
    },
    "ThreadRef": {
      "type": "object",
      "required": ["projectRef", "threadId"],
      "properties": {
        "threadId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        }
      },
      "additionalProperties": false
    },
    "TurnRef": {
      "type": "object",
      "required": ["threadRef", "turnId"],
      "properties": {
        "threadRef": { "$ref": "#/$defs/ThreadRef" },
        "turnId": { "$ref": "common.schema.json#/$defs/Identifier" }
      },
      "additionalProperties": false
    },
    "WorkspaceIdentity": {
      "type": "object",
      "required": ["projectRef", "rootFingerprint"],
      "properties": {
        "projectRef": { "$ref": "#/$defs/ProjectRef" },
        "rootFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "ApplicationSummary": {
      "type": "object",
      "required": ["ref", "kind", "displayName", "capabilities"],
      "properties": {
        "ref": { "$ref": "#/$defs/ApplicationRef" },
        "kind": { "$ref": "common.schema.json#/$defs/Identifier" },
        "displayName": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "capabilities": {
          "$ref": "capabilities.schema.json#/$defs/ApplicationCapabilities"
        },
        "workspaceIdentity": {
          "oneOf": [
            { "$ref": "#/$defs/WorkspaceIdentity" },
            { "type": "null" }
          ]
        },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "projects": {
                    "properties": { "mode": { "enum": ["flat", "fixed"] } },
                    "required": ["mode"]
                  }
                },
                "required": ["projects"]
              }
            },
            "required": ["capabilities"]
          },
          "then": {
            "required": ["workspaceIdentity"],
            "properties": {
              "workspaceIdentity": { "$ref": "#/$defs/WorkspaceIdentity" }
            }
          },
          "else": {
            "properties": { "workspaceIdentity": { "type": "null" } }
          }
        }
      ],
      "additionalProperties": false
    },
    "ProjectSummary": {
      "type": "object",
      "required": ["ref", "displayName"],
      "properties": {
        "ref": { "$ref": "#/$defs/ProjectRef" },
        "displayName": { "$ref": "common.schema.json#/$defs/NonEmptyString" },
        "rootPath": { "type": ["string", "null"] },
        "repoUrl": { "type": ["string", "null"], "format": "uri" },
        "workspaceRootFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    },
    "ThreadStatus": {
      "enum": [
        "idle",
        "running",
        "waiting_for_approval",
        "waiting_for_input",
        "completed",
        "failed",
        "interrupted",
        "unknown"
      ]
    },
    "ThreadSummary": {
      "type": "object",
      "required": ["ref", "status"],
      "properties": {
        "ref": { "$ref": "#/$defs/ThreadRef" },
        "title": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/ThreadStatus" },
        "updatedAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Timestamp" },
            { "type": "null" }
          ]
        },
        "metadata": { "$ref": "common.schema.json#/$defs/Metadata" }
      },
      "additionalProperties": false
    }
  }
}
