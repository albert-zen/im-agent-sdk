{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.imagent.dev/v1/projections.schema.json",
  "title": "IM Agent Thread projection routing",
  "$defs": {
    "ProjectionPolicy": {
      "enum": [
        "foreground_only",
        "remembered_last_recipient",
        "all_observers"
      ]
    },
    "ThreadProjectionRoute": {
      "type": "object",
      "required": [
        "routeId",
        "threadRef",
        "conversationRef",
        "replyToMessageId",
        "checkpointAgentItemId",
        "checkpointedAt",
        "updatedAt"
      ],
      "properties": {
        "routeId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "threadRef": {
          "$ref": "resources.schema.json#/$defs/ThreadRef"
        },
        "conversationRef": {
          "$ref": "messages.schema.json#/$defs/ConversationRef"
        },
        "replyToMessageId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "checkpointAgentItemId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "checkpointedAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Timestamp" },
            { "type": "null" }
          ]
        },
        "updatedAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Timestamp" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["checkpointAgentItemId"],
            "properties": {
              "checkpointAgentItemId": {
                "$ref": "common.schema.json#/$defs/Identifier"
              }
            }
          },
          "then": {
            "required": ["checkpointedAt"],
            "properties": {
              "checkpointedAt": {
                "$ref": "common.schema.json#/$defs/Timestamp"
              }
            }
          }
        },
        {
          "if": {
            "required": ["checkpointedAt"],
            "properties": {
              "checkpointedAt": {
                "$ref": "common.schema.json#/$defs/Timestamp"
              }
            }
          },
          "then": {
            "required": ["checkpointAgentItemId"],
            "properties": {
              "checkpointAgentItemId": {
                "$ref": "common.schema.json#/$defs/Identifier"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "TurnReplyCorrelation": {
      "type": "object",
      "required": [
        "correlationId",
        "turnRef",
        "clientMessageId",
        "conversationRef",
        "replyToMessageId",
        "createdAt"
      ],
      "properties": {
        "correlationId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "turnRef": { "$ref": "resources.schema.json#/$defs/TurnRef" },
        "clientMessageId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "conversationRef": {
          "$ref": "messages.schema.json#/$defs/ConversationRef"
        },
        "replyToMessageId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "RequestRouteCorrelation": {
      "type": "object",
      "required": [
        "correlationId",
        "requestRef",
        "turnRef",
        "conversationRef",
        "deliveryId",
        "responseShape",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "correlationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "requestRef": { "$ref": "resources.schema.json#/$defs/RequestRef" },
        "turnRef": { "$ref": "resources.schema.json#/$defs/TurnRef" },
        "conversationRef": {
          "$ref": "messages.schema.json#/$defs/ConversationRef"
        },
        "deliveryId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "responseShape": {
          "$ref": "events.schema.json#/$defs/RequestResponseShape"
        },
        "state": {
          "enum": ["open", "responded", "resolved", "stale"]
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "expiresAt": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Timestamp" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
