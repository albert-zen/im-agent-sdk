{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.imagent.dev/v1/operations.schema.json",
  "title": "IM Agent typed operations",
  "$defs": {
    "ApplicationOperationType": {
      "enum": [
        "project.list",
        "project.get",
        "project.create",
        "thread.create",
        "thread.list",
        "thread.get",
        "thread.activate_native",
        "thread.delete",
        "thread.status",
        "thread.history",
        "turn.catchup",
        "turn.interrupt",
        "request.respond"
      ]
    },
    "GatewayOperationType": {
      "enum": [
        "application.list",
        "application.select",
        "conversation.bind_project",
        "conversation.bind_thread",
        "conversation.clear_thread",
        "conversation.respond_request",
        "thread.observe"
      ]
    },
    "ApplicationOperationIdentity": {
      "type": "object",
      "required": ["operationId", "type", "applicationRef", "createdAt"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/ApplicationOperationType" },
        "applicationRef": {
          "$ref": "resources.schema.json#/$defs/ApplicationRef"
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "GatewayOperationIdentity": {
      "type": "object",
      "required": [
        "operationId",
        "type",
        "conversationRef",
        "actor",
        "createdAt"
      ],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/GatewayOperationType" },
        "conversationRef": {
          "$ref": "messages.schema.json#/$defs/ConversationRef"
        },
        "actor": { "$ref": "common.schema.json#/$defs/Identifier" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ListProjects": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "project.list" },
            "query": { "type": ["string", "null"] },
            "cursor": { "type": ["string", "null"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "GetProject": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "projectRef"],
          "properties": {
            "type": { "const": "project.get" },
            "projectRef": {
              "$ref": "resources.schema.json#/$defs/ProjectRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CreateProject": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "cwd"],
          "properties": {
            "type": { "const": "project.create" },
            "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "displayName": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CreateThread": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "projectRef", "initialContext"],
          "properties": {
            "type": { "const": "thread.create" },
            "projectRef": {
              "$ref": "resources.schema.json#/$defs/ProjectRef"
            },
            "title": { "type": ["string", "null"] },
            "initialContext": {
              "type": "array",
              "items": { "$ref": "messages.schema.json#/$defs/Content" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ListThreads": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "projectRef"],
          "properties": {
            "type": { "const": "thread.list" },
            "projectRef": {
              "$ref": "resources.schema.json#/$defs/ProjectRef"
            },
            "query": { "type": ["string", "null"] },
            "cursor": { "type": ["string", "null"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadOperationIdentity": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["threadRef"],
          "properties": {
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            }
          }
        }
      ]
    },
    "GetThread": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "thread.get" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "ActivateNativeThread": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "thread.activate_native" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "DeleteThread": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "mode"],
          "properties": {
            "type": { "const": "thread.delete" },
            "mode": { "enum": ["archive", "permanent"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "GetThreadStatus": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "thread.status" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "GetThreadHistory": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "limit", "page"],
          "properties": {
            "type": { "const": "thread.history" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 20 },
            "page": { "type": "integer", "minimum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "GetTurnCatchup": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "limit"],
          "properties": {
            "type": { "const": "turn.catchup" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InterruptTurn": {
      "allOf": [
        { "$ref": "#/$defs/ThreadOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "turn.interrupt" },
            "turnRef": {
              "oneOf": [
                { "$ref": "resources.schema.json#/$defs/TurnRef" },
                { "type": "null" }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApprovalResponse": {
      "type": "object",
      "required": ["kind", "choiceId"],
      "properties": {
        "kind": { "const": "approval" },
        "choiceId": { "$ref": "common.schema.json#/$defs/Identifier" }
      },
      "additionalProperties": false
    },
    "UserInputResponse": {
      "type": "object",
      "required": ["kind", "answers"],
      "properties": {
        "kind": { "const": "user_input" },
        "answers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "RequestResponse": {
      "oneOf": [
        { "$ref": "#/$defs/ApprovalResponse" },
        { "$ref": "#/$defs/UserInputResponse" }
      ]
    },
    "RespondRequest": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "requestRef", "turnRef", "response"],
          "properties": {
            "type": { "const": "request.respond" },
            "requestRef": {
              "$ref": "resources.schema.json#/$defs/RequestRef"
            },
            "turnRef": { "$ref": "resources.schema.json#/$defs/TurnRef" },
            "response": { "$ref": "#/$defs/RequestResponse" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApplicationOperation": {
      "oneOf": [
        { "$ref": "#/$defs/ListProjects" },
        { "$ref": "#/$defs/GetProject" },
        { "$ref": "#/$defs/CreateProject" },
        { "$ref": "#/$defs/CreateThread" },
        { "$ref": "#/$defs/ListThreads" },
        { "$ref": "#/$defs/GetThread" },
        { "$ref": "#/$defs/ActivateNativeThread" },
        { "$ref": "#/$defs/DeleteThread" },
        { "$ref": "#/$defs/GetThreadStatus" },
        { "$ref": "#/$defs/GetThreadHistory" },
        { "$ref": "#/$defs/GetTurnCatchup" },
        { "$ref": "#/$defs/InterruptTurn" },
        { "$ref": "#/$defs/RespondRequest" }
      ]
    },
    "ListApplications": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "application.list" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "SelectApplication": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "applicationRef"],
          "properties": {
            "type": { "const": "application.select" },
            "applicationRef": {
              "$ref": "resources.schema.json#/$defs/ApplicationRef"
            },
            "expectedRevision": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BindConversationToProject": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "projectRef"],
          "properties": {
            "type": { "const": "conversation.bind_project" },
            "projectRef": {
              "$ref": "resources.schema.json#/$defs/ProjectRef"
            },
            "expectedRevision": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "BindConversationToThread": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef"],
          "properties": {
            "type": { "const": "conversation.bind_thread" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            },
            "expectedRevision": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ClearConversationThread": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "conversation.clear_thread" },
            "expectedRevision": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ObserveThread": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef", "replyToMessageId"],
          "properties": {
            "type": { "const": "thread.observe" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            },
            "replyToMessageId": {
              "oneOf": [
                { "$ref": "common.schema.json#/$defs/Identifier" },
                { "type": "null" }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RespondToRequest": {
      "allOf": [
        { "$ref": "#/$defs/GatewayOperationIdentity" },
        {
          "type": "object",
          "required": ["type", "requestRef", "response"],
          "properties": {
            "type": { "const": "conversation.respond_request" },
            "requestRef": {
              "$ref": "resources.schema.json#/$defs/RequestRef"
            },
            "response": { "$ref": "#/$defs/RequestResponse" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "GatewayOperation": {
      "oneOf": [
        { "$ref": "#/$defs/ListApplications" },
        { "$ref": "#/$defs/SelectApplication" },
        { "$ref": "#/$defs/BindConversationToProject" },
        { "$ref": "#/$defs/BindConversationToThread" },
        { "$ref": "#/$defs/ClearConversationThread" },
        { "$ref": "#/$defs/ObserveThread" },
        { "$ref": "#/$defs/RespondToRequest" }
      ]
    },
    "ProjectPage": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "resources.schema.json#/$defs/ProjectSummary" }
        },
        "nextCursor": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ThreadPage": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "resources.schema.json#/$defs/ThreadSummary" }
        },
        "nextCursor": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ApplicationSuccessIdentity": {
      "type": "object",
      "required": ["operationId", "type", "status", "completedAt"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/ApplicationOperationType" },
        "status": { "const": "succeeded" },
        "completedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ProjectsListed": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "projects"],
          "properties": {
            "type": { "const": "project.list" },
            "projects": { "$ref": "#/$defs/ProjectPage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ProjectRead": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "project"],
          "properties": {
            "type": { "const": "project.get" },
            "project": {
              "$ref": "resources.schema.json#/$defs/ProjectSummary"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ProjectCreated": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "project"],
          "properties": {
            "type": { "const": "project.create" },
            "project": { "$ref": "resources.schema.json#/$defs/ProjectSummary" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadCreated": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "thread"],
          "properties": {
            "type": { "const": "thread.create" },
            "thread": {
              "$ref": "resources.schema.json#/$defs/ThreadSummary"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadsListed": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "threads"],
          "properties": {
            "type": { "const": "thread.list" },
            "threads": { "$ref": "#/$defs/ThreadPage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadRead": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "thread"],
          "properties": {
            "type": { "const": "thread.get" },
            "thread": {
              "$ref": "resources.schema.json#/$defs/ThreadSummary"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "NativeThreadActivated": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef"],
          "properties": {
            "type": { "const": "thread.activate_native" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadDeleted": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef", "mode"],
          "properties": {
            "type": { "const": "thread.delete" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            },
            "mode": { "enum": ["archive", "permanent"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadStatusRead": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef", "threadStatus"],
          "properties": {
            "type": { "const": "thread.status" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            },
            "threadStatus": {
              "$ref": "resources.schema.json#/$defs/ThreadStatus"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadHistoryRead": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "history"],
          "properties": {
            "type": { "const": "thread.history" },
            "history": { "$ref": "history.schema.json#/$defs/ThreadHistory" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TurnCatchupRead": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "catchup"],
          "properties": {
            "type": { "const": "turn.catchup" },
            "catchup": { "$ref": "history.schema.json#/$defs/TurnCatchup" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "TurnInterrupted": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "threadRef", "turnRef"],
          "properties": {
            "type": { "const": "turn.interrupt" },
            "threadRef": {
              "$ref": "resources.schema.json#/$defs/ThreadRef"
            },
            "turnRef": {
              "oneOf": [
                { "$ref": "resources.schema.json#/$defs/TurnRef" },
                { "type": "null" }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RequestResponded": {
      "allOf": [
        { "$ref": "#/$defs/ApplicationSuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "requestRef"],
          "properties": {
            "type": { "const": "request.respond" },
            "requestRef": {
              "$ref": "resources.schema.json#/$defs/RequestRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ApplicationOperationFailed": {
      "type": "object",
      "required": ["operationId", "type", "status", "error", "completedAt"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/ApplicationOperationType" },
        "status": { "const": "failed" },
        "error": { "$ref": "common.schema.json#/$defs/Error" },
        "completedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      },
      "additionalProperties": false
    },
    "ApplicationOperationResult": {
      "oneOf": [
        { "$ref": "#/$defs/ProjectsListed" },
        { "$ref": "#/$defs/ProjectRead" },
        { "$ref": "#/$defs/ProjectCreated" },
        { "$ref": "#/$defs/ThreadCreated" },
        { "$ref": "#/$defs/ThreadsListed" },
        { "$ref": "#/$defs/ThreadRead" },
        { "$ref": "#/$defs/NativeThreadActivated" },
        { "$ref": "#/$defs/ThreadDeleted" },
        { "$ref": "#/$defs/ThreadStatusRead" },
        { "$ref": "#/$defs/ThreadHistoryRead" },
        { "$ref": "#/$defs/TurnCatchupRead" },
        { "$ref": "#/$defs/TurnInterrupted" },
        { "$ref": "#/$defs/RequestResponded" },
        { "$ref": "#/$defs/ApplicationOperationFailed" }
      ]
    },
    "GatewaySuccessIdentity": {
      "type": "object",
      "required": ["operationId", "type", "status", "completedAt"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/GatewayOperationType" },
        "status": { "const": "succeeded" },
        "completedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ApplicationsListed": {
      "allOf": [
        { "$ref": "#/$defs/GatewaySuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "applications"],
          "properties": {
            "type": { "const": "application.list" },
            "applications": {
              "type": "array",
              "items": {
                "$ref": "resources.schema.json#/$defs/ApplicationSummary"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ConversationBound": {
      "allOf": [
        { "$ref": "#/$defs/GatewaySuccessIdentity" },
        {
          "type": "object",
          "required": ["binding"],
          "properties": {
            "type": {
              "enum": [
                "application.select",
                "conversation.bind_project",
                "conversation.bind_thread",
                "conversation.clear_thread"
              ]
            },
            "binding": {
              "$ref": "bindings.schema.json#/$defs/ConversationBinding"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ThreadObserved": {
      "allOf": [
        { "$ref": "#/$defs/GatewaySuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "route"],
          "properties": {
            "type": { "const": "thread.observe" },
            "route": {
              "$ref": "projections.schema.json#/$defs/ThreadProjectionRoute"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RequestResponseRouted": {
      "allOf": [
        { "$ref": "#/$defs/GatewaySuccessIdentity" },
        {
          "type": "object",
          "required": ["type", "requestRef"],
          "properties": {
            "type": { "const": "conversation.respond_request" },
            "requestRef": {
              "$ref": "resources.schema.json#/$defs/RequestRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "GatewayOperationFailed": {
      "type": "object",
      "required": ["operationId", "type", "status", "error", "completedAt"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "type": { "$ref": "#/$defs/GatewayOperationType" },
        "status": { "const": "failed" },
        "error": { "$ref": "common.schema.json#/$defs/Error" },
        "completedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      },
      "additionalProperties": false
    },
    "GatewayOperationResult": {
      "oneOf": [
        { "$ref": "#/$defs/ApplicationsListed" },
